# Required by docker-compose.yml. Replace every placeholder before deploying.
ADMIN_PASSWORD=replace-with-a-long-unique-password
SECRET_KEY=replace-with-output-from-openssl-rand-hex-32

# Pushover application token and destination user/group key.
PUSHOVER_API_TOKEN=replace-with-pushover-application-token
PUSHOVER_USER_KEY=replace-with-pushover-user-or-group-key

# DATA_DIR and COOKIE_SECURE are fixed by docker-compose.yml. Other application
# overrides must also be added to menu.environment before Compose passes them.
